{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "Tutor: FastAPI (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}",
      "args": [
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "7003",
        "--reload"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "HOST": "0.0.0.0",
        "PORT": "7003",
        "SECRET_KEY": "dev-secret-key",
        "ALGORITHM": "HS256"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
